<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myfinance.controller.TambahTransaksiController"
      prefWidth="1024" prefHeight="680">

    <!-- ====== SIDEBAR ====== -->
    <VBox styleClass="sidebar">
        <Label text="💰 myFinance"      styleClass="sidebar-title"/>
        <Label text="Keuangan Pribadi"  styleClass="sidebar-subtitle"/>
        <Separator styleClass="sidebar-divider"/>
        <Button text="🏠  Dashboard"        styleClass="nav-button" onAction="#handleDashboard"/>
        <Button text="➕  Tambah Transaksi"  styleClass="nav-button, nav-button-active" onAction="#handleTambah"/>
        <Button text="📋  Riwayat"           styleClass="nav-button" onAction="#handleRiwayat"/>
        <Button text="📊  Statistik"         styleClass="nav-button" onAction="#handleStatistik"/>
        <Button text="🎯  Anggaran"          styleClass="nav-button" onAction="#handleAnggaran"/>
        <Button text="🏷  Kategori"          styleClass="nav-button" onAction="#handleKategori"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator styleClass="sidebar-divider"/>
        <Button text="🚪  Logout"            styleClass="nav-button-danger" onAction="#handleLogout"/>
    </VBox>

    <!-- ====== KONTEN ====== -->
    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true" styleClass="scroll-pane">
        <VBox styleClass="content-area" spacing="20">

            <!-- Header -->
            <VBox spacing="4">
                <Label fx:id="lblJudul" text="Tambah Transaksi" styleClass="label-judul-halaman"/>
                <Label text="Isi form di bawah untuk mencatat transaksi baru." styleClass="label-subtitle"/>
            </VBox>

            <!-- Info Saldo -->
            <HBox styleClass="card" spacing="24" alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="💳 Total Saldo Saat Ini" styleClass="label-form"/>
                    <Label fx:id="lblSaldo" text="Rp 0" styleClass="label-saldo"/>
                </VBox>
                <VBox spacing="4" alignment="CENTER_RIGHT">
                    <Label text="⚠️ Peringatan" styleClass="label-form"/>
                    <Label fx:id="lblWarningAnggaran" text="" styleClass="label-expense" wrapText="true" maxWidth="280"/>
                </VBox>
            </HBox>

            <!-- Form Card -->
            <VBox styleClass="card" spacing="20">

                <!-- Baris 1: Jenis Transaksi (Toggle Button kiri/kanan) -->
                <VBox spacing="8">
                    <Label text="Jenis Transaksi" styleClass="label-form"/>
                    <HBox fx:id="hboxTipe" spacing="0" styleClass="tipe-toggle-group" maxWidth="Infinity">
                        <Button fx:id="btnPemasukan"
                                text="⬆  Pemasukan"
                                styleClass="tipe-btn, tipe-btn-left"
                                onAction="#handlePilihPemasukan"
                                HBox.hgrow="ALWAYS" prefHeight="44"/>
                        <Button fx:id="btnPengeluaran"
                                text="⬇  Pengeluaran"
                                styleClass="tipe-btn, tipe-btn-right"
                                onAction="#handlePilihPengeluaran"
                                HBox.hgrow="ALWAYS" prefHeight="44"/>
                    </HBox>
                </VBox>

                <!-- Baris 2: Kategori (chip button, muncul setelah tipe dipilih) -->
                <VBox fx:id="vboxKategori" spacing="8" managed="false" visible="false">
                    <Label text="Kategori" styleClass="label-form"/>
                    <FlowPane fx:id="flowKategori"
                              hgap="8" vgap="8"
                              prefWrapLength="520"/>
                </VBox>

                <!-- Baris 3: Tanggal -->
                <VBox spacing="6">
                    <Label text="Tanggal" styleClass="label-form"/>
                    <DatePicker fx:id="dpTanggal" maxWidth="Infinity"
                                styleClass="date-picker"
                                promptText="Pilih tanggal transaksi"/>
                </VBox>

                <!-- Baris 4: Nominal + Quick-Amount Buttons -->
                <VBox spacing="8">
                    <Label text="Nominal (Rp)" styleClass="label-form"/>
                    <TextField fx:id="tfNominal"
                               promptText="Contoh: 15000"
                               styleClass="text-field"
                               maxWidth="Infinity"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FlowPane fx:id="flowNominal"
                                  hgap="8" vgap="8"
                                  prefWrapLength="440" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnReset" text="↺ Reset"
                                styleClass="btn-secondary"
                                onAction="#handleResetNominal"
                                prefWidth="80" prefHeight="32"/>
                    </HBox>
                </VBox>

                <!-- Baris 5: Keterangan (opsional) -->
                <VBox spacing="6">
                    <Label text="Keterangan (Opsional)" styleClass="label-form"/>
                    <TextField fx:id="tfKeterangan"
                               promptText="Contoh: Makan siang bersama teman"
                               styleClass="text-field"
                               maxWidth="Infinity"/>
                </VBox>

                <!-- Label error -->
                <Label fx:id="lblError" text="" styleClass="label-expense"
                       wrapText="true" maxWidth="520"/>

                <!-- Tombol Aksi -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Kembali" styleClass="btn-secondary"
                            onAction="#handleBatal" prefWidth="120"/>
                    <Button text="💾  Simpan" styleClass="btn-primary"
                            onAction="#handleSimpan" prefWidth="160"/>
                </HBox>

            </VBox>
        </VBox>
    </ScrollPane>
</HBox>