<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    riwayat.fxml — Halaman Riwayat Transaksi
    Sesuai wireframe proposal: tabel dengan kolom Tanggal, Kategori,
    Jenis, Nominal, Keterangan, dan Aksi (tombol Edit + Hapus).
    Tombol Edit/Hapus diisi via CellFactory di RiwayatController.
-->
<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myfinance.controller.RiwayatController"
      prefWidth="1024" prefHeight="680">

    <!-- ====== SIDEBAR ====== -->
    <VBox styleClass="sidebar" prefWidth="220" minWidth="220">
        <Label text="💰 myFinance"      styleClass="sidebar-title"/>
        <Label text="Keuangan Pribadi"  styleClass="sidebar-subtitle"/>
        <Separator styleClass="sidebar-divider"/>
        <Button text="🏠  Dashboard"        styleClass="nav-button" onAction="#handleDashboard"  prefWidth="220"/>
        <Button text="➕  Tambah Transaksi"  styleClass="nav-button" onAction="#handleTambah"    prefWidth="220"/>
        <Button text="📋  Riwayat"           styleClass="nav-button, nav-button-active" onAction="#handleRiwayat" prefWidth="220"/>
        <Button text="📊  Statistik"         styleClass="nav-button" onAction="#handleStatistik" prefWidth="220"/>
        <Button text="🎯  Anggaran"          styleClass="nav-button" onAction="#handleAnggaran"  prefWidth="220"/>
        <Button text="🏷  Kategori"          styleClass="nav-button" onAction="#handleKategori"  prefWidth="220"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator styleClass="sidebar-divider"/>
        <Button text="🚪  Logout"            styleClass="nav-button-danger" onAction="#handleLogout" prefWidth="220"/>
    </VBox>

    <!-- ====== KONTEN ====== -->
    <VBox HBox.hgrow="ALWAYS" styleClass="content-area" spacing="20">

        <!-- Header -->
        <VBox spacing="4">
            <Label text="Riwayat Transaksi" styleClass="label-judul-halaman"/>
            <Label text="Semua catatan pemasukan dan pengeluaran Anda." styleClass="label-subtitle"/>
        </VBox>

        <!-- Filter bar -->
        <HBox styleClass="card" spacing="12" alignment="CENTER_LEFT">
            <Label text="Filter:" styleClass="label-form"/>

            <ComboBox fx:id="cbFilterTipe" prefWidth="160"
                      promptText="Semua Jenis"
                      styleClass="combo-box"
                      onAction="#handleFilter"/>

            <ComboBox fx:id="cbFilterBulan" prefWidth="130"
                      promptText="Semua Bulan"
                      styleClass="combo-box"
                      onAction="#handleFilter"/>

            <ComboBox fx:id="cbFilterTahun" prefWidth="100"
                      promptText="Semua Tahun"
                      styleClass="combo-box"
                      onAction="#handleFilter"/>

            <Button text="🔄 Reset Filter" styleClass="btn-secondary"
                    onAction="#handleResetFilter"/>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <Button text="➕ Tambah Baru" styleClass="btn-primary"
                    onAction="#handleTambah"/>
        </HBox>

        <!-- Tabel Riwayat -->
        <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="8">

            <Label fx:id="lblJumlah" text="Menampilkan semua transaksi"
                   styleClass="label-subtitle"/>

            <TableView fx:id="tableRiwayat" VBox.vgrow="ALWAYS"
                       styleClass="table-view">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <!-- Kolom Tanggal -->
                <columns>
                    <TableColumn fx:id="kolTanggal"    text="Tanggal"    prefWidth="110"/>
                    <TableColumn fx:id="kolKategori"   text="Kategori"   prefWidth="140"/>
                    <TableColumn fx:id="kolTipe"       text="Jenis"      prefWidth="110"/>
                    <TableColumn fx:id="kolNominal"    text="Nominal"    prefWidth="150"/>
                    <TableColumn fx:id="kolKeterangan" text="Keterangan" prefWidth="200"/>
                    <!-- Kolom Aksi: tombol Edit + Hapus diisi via CellFactory -->
                    <TableColumn fx:id="kolAksi"       text="Aksi"       prefWidth="150"/>
                </columns>

            </TableView>
        </VBox>
    </VBox>
</HBox>
