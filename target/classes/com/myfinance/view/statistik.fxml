<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<!--
    statistik.fxml — Halaman Statistik Keuangan
    Menampilkan BarChart pengeluaran per kategori + ringkasan periode
-->
<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myfinance.controller.StatistikController"
      prefWidth="1024" prefHeight="680">

    <!-- ====== SIDEBAR ====== -->
    <VBox styleClass="sidebar" prefWidth="220" minWidth="220">
        <Label text="💰 myFinance"      styleClass="sidebar-title"/>
        <Label text="Keuangan Pribadi"  styleClass="sidebar-subtitle"/>
        <Separator styleClass="sidebar-divider"/>
        <Button text="🏠  Dashboard"        styleClass="nav-button" onAction="#handleDashboard"  prefWidth="220"/>
        <Button text="➕  Tambah Transaksi"  styleClass="nav-button" onAction="#handleTambah"    prefWidth="220"/>
        <Button text="📋  Riwayat"           styleClass="nav-button" onAction="#handleRiwayat"   prefWidth="220"/>
        <Button text="📊  Statistik"         styleClass="nav-button, nav-button-active" onAction="#handleStatistik" prefWidth="220"/>
        <Button text="🎯  Anggaran"          styleClass="nav-button" onAction="#handleAnggaran"  prefWidth="220"/>
        <Button text="🏷  Kategori"          styleClass="nav-button" onAction="#handleKategori"  prefWidth="220"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator styleClass="sidebar-divider"/>
        <Button text="🚪  Logout"            styleClass="nav-button-danger" onAction="#handleLogout" prefWidth="220"/>
    </VBox>

    <!-- ====== KONTEN ====== -->
    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true" styleClass="scroll-pane">
        <VBox styleClass="content-area" spacing="20">

            <!-- Header -->
            <VBox spacing="4">
                <Label text="Statistik Keuangan" styleClass="label-judul-halaman"/>
                <Label text="Visualisasi pola pengeluaran Anda berdasarkan kategori."
                       styleClass="label-subtitle"/>
            </VBox>

            <!-- Filter Periode -->
            <HBox styleClass="card" spacing="12" alignment="CENTER_LEFT">
                <Label text="Filter Periode:" styleClass="label-form"/>
                <ComboBox fx:id="cbBulan" prefWidth="130" promptText="Pilih Bulan"
                          styleClass="combo-box" onAction="#handleFilter"/>
                <ComboBox fx:id="cbTahun" prefWidth="100" promptText="Tahun"
                          styleClass="combo-box" onAction="#handleFilter"/>
                <Label fx:id="lblPeriode" styleClass="label-subtitle"/>
            </HBox>

            <!-- BarChart Pengeluaran per Kategori -->
            <VBox styleClass="card" spacing="12">
                <Label text="Pengeluaran per Kategori" styleClass="label-section"/>
                <BarChart fx:id="barChart" prefHeight="320" animated="false"
                          styleClass="chart">
                    <xAxis><CategoryAxis label="Kategori"/></xAxis>
                    <yAxis><NumberAxis label="Nominal (Rp)"/></yAxis>
                </BarChart>
            </VBox>

            <!-- Kartu Ringkasan Periode -->
            <HBox spacing="16">
                <VBox styleClass="card-summary, card-income" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="⬆  Total Pemasukan Periode Ini" styleClass="label-card-title"/>
                    <Label fx:id="lblTotalMasuk" text="Rp 0"
                           styleClass="label-card-nilai, label-income"/>
                </VBox>
                <VBox styleClass="card-summary, card-expense" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="⬇  Total Pengeluaran Periode Ini" styleClass="label-card-title"/>
                    <Label fx:id="lblTotalKeluar" text="Rp 0"
                           styleClass="label-card-nilai, label-expense"/>
                </VBox>
                <VBox styleClass="card-summary, card-balance" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="💳  Selisih (Hemat/Defisit)" styleClass="label-card-title"/>
                    <Label fx:id="lblSelisih" text="Rp 0" styleClass="label-card-nilai"/>
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>
</HBox>
