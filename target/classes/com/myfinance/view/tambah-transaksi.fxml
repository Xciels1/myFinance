<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    tambah-transaksi.fxml — Halaman Tambah / Edit Transaksi
    Sesuai wireframe proposal: form dengan Jenis, Kategori,
    Tanggal, Nominal, Keterangan, tombol Kembali + Simpan
-->
<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myfinance.controller.TambahTransaksiController"
      prefWidth="1024" prefHeight="680">

    <!-- ====== SIDEBAR ====== -->
    <VBox styleClass="sidebar" prefWidth="220" minWidth="220">
        <Label text="💰 myFinance"      styleClass="sidebar-title"/>
        <Label text="Keuangan Pribadi"  styleClass="sidebar-subtitle"/>
        <Separator styleClass="sidebar-divider"/>
        <Button text="🏠  Dashboard"        styleClass="nav-button" onAction="#handleDashboard"  prefWidth="220"/>
        <Button text="➕  Tambah Transaksi"  styleClass="nav-button, nav-button-active" onAction="#handleTambah" prefWidth="220"/>
        <Button text="📋  Riwayat"           styleClass="nav-button" onAction="#handleRiwayat"   prefWidth="220"/>
        <Button text="📊  Statistik"         styleClass="nav-button" onAction="#handleStatistik" prefWidth="220"/>
        <Button text="🎯  Anggaran"          styleClass="nav-button" onAction="#handleAnggaran"  prefWidth="220"/>
        <Button text="🏷  Kategori"          styleClass="nav-button" onAction="#handleKategori"  prefWidth="220"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator styleClass="sidebar-divider"/>
        <Button text="🚪  Logout"            styleClass="nav-button-danger" onAction="#handleLogout" prefWidth="220"/>
    </VBox>

    <!-- ====== KONTEN ====== -->
    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true" styleClass="scroll-pane">
        <VBox styleClass="content-area" spacing="20">

            <!-- Header -->
            <VBox spacing="4">
                <Label fx:id="lblJudul" text="Tambah Transaksi" styleClass="label-judul-halaman"/>
                <Label text="Isi form di bawah untuk mencatat transaksi baru." styleClass="label-subtitle"/>
            </VBox>

            <!-- Form Card -->
            <VBox styleClass="card" spacing="20" maxWidth="560">

                <!-- Baris 1: Jenis Transaksi -->
                <VBox spacing="6">
                    <Label text="Jenis Transaksi" styleClass="label-form"/>
                    <ComboBox fx:id="cbTipe" prefWidth="520"
                              promptText="Pilih Pemasukan atau Pengeluaran"
                              onAction="#handleTipeChanged"
                              styleClass="combo-box"/>
                </VBox>

                <!-- Baris 2: Kategori (isinya berubah sesuai tipe) -->
                <VBox spacing="6">
                    <Label text="Kategori" styleClass="label-form"/>
                    <ComboBox fx:id="cbKategori" prefWidth="520"
                              promptText="Pilih kategori"
                              styleClass="combo-box"/>
                </VBox>

                <!-- Baris 3: Tanggal -->
                <VBox spacing="6">
                    <Label text="Tanggal" styleClass="label-form"/>
                    <DatePicker fx:id="dpTanggal" prefWidth="520"
                                styleClass="date-picker"
                                promptText="Pilih tanggal transaksi"/>
                </VBox>

                <!-- Baris 4: Nominal -->
                <VBox spacing="6">
                    <Label text="Nominal (Rp)" styleClass="label-form"/>
                    <TextField fx:id="tfNominal"
                               promptText="Contoh: 15000"
                               styleClass="text-field"
                               prefWidth="520"/>
                </VBox>

                <!-- Baris 5: Keterangan (opsional) -->
                <VBox spacing="6">
                    <Label text="Keterangan (Opsional)" styleClass="label-form"/>
                    <TextField fx:id="tfKeterangan"
                               promptText="Contoh: Makan siang bersama teman"
                               styleClass="text-field"
                               prefWidth="520"/>
                </VBox>

                <!-- Label error -->
                <Label fx:id="lblError" text="" styleClass="label-expense"
                       wrapText="true" maxWidth="520"/>

                <!-- Tombol Aksi -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <Button text="Kembali" styleClass="btn-secondary"
                            onAction="#handleBatal" prefWidth="120"/>
                    <Button text="💾  Simpan" styleClass="btn-primary"
                            onAction="#handleSimpan" prefWidth="160"/>
                </HBox>

            </VBox>
        </VBox>
    </ScrollPane>
</HBox>
