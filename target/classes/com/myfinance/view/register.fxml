<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    register.fxml — Halaman Registrasi Akun Baru
-->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.myfinance.controller.RegisterController"
           styleClass="login-container"
           prefWidth="1024" prefHeight="680">

    <VBox styleClass="login-card" alignment="CENTER" spacing="18"
          maxWidth="380" StackPane.alignment="CENTER">

        <Label text="💰 myFinance" styleClass="login-title"/>
        <Label text="Buat akun baru" styleClass="login-subtitle"/>

        <Separator prefWidth="300"/>

        <!-- Field Username -->
        <VBox spacing="6">
            <Label text="Username" styleClass="label-form"/>
            <TextField fx:id="tfUsername"
                       promptText="Buat username unik"
                       styleClass="text-field"
                       prefWidth="300"/>
        </VBox>

        <!-- Field Password -->
        <VBox spacing="6">
            <Label text="Password" styleClass="label-form"/>
            <PasswordField fx:id="pfPassword"
                           promptText="Buat password"
                           styleClass="password-field"
                           prefWidth="300"/>
        </VBox>

        <!-- Field Konfirmasi Password -->
        <VBox spacing="6">
            <Label text="Konfirmasi Password" styleClass="label-form"/>
            <PasswordField fx:id="pfKonfirmasi"
                           promptText="Ulangi password"
                           styleClass="password-field"
                           prefWidth="300"/>
        </VBox>

        <!-- Label error/sukses -->
        <Label fx:id="lblPesan"
               styleClass="label-expense"
               text=""
               wrapText="true"
               maxWidth="300"/>

        <!-- Tombol Daftar -->
        <Button text="Daftar"
                styleClass="btn-success"
                onAction="#handleRegister"
                prefWidth="300" prefHeight="42"/>

        <!-- Link balik ke Login -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="Sudah punya akun?" styleClass="label-subtitle"/>
            <Hyperlink text="Login di sini" onAction="#handleKeLogin"/>
        </HBox>

    </VBox>
</StackPane>
