<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    anggaran.fxml — Halaman Manajemen Anggaran
    Kiri: Form tambah/edit limit anggaran per kategori
    Kanan: Tabel daftar anggaran + realisasi bulan ini
-->
<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.myfinance.controller.AnggaranController"
      prefWidth="1024" prefHeight="680">

    <!-- ====== SIDEBAR ====== -->
    <VBox styleClass="sidebar">
        <Label text="💰 myFinance"      styleClass="sidebar-title"/>
        <Label text="Keuangan Pribadi"  styleClass="sidebar-subtitle"/>
        <Separator styleClass="sidebar-divider"/>
        <Button text="🏠  Dashboard"        styleClass="nav-button" onAction="#handleDashboard"/>
        <Button text="➕  Tambah Transaksi"  styleClass="nav-button" onAction="#handleTambah"/>
        <Button text="📋  Riwayat"           styleClass="nav-button" onAction="#handleRiwayat"/>
        <Button text="📊  Statistik"         styleClass="nav-button" onAction="#handleStatistik"/>
        <Button text="🎯  Anggaran"          styleClass="nav-button, nav-button-active" onAction="#handleAnggaran"/>
        <Button text="🏷  Kategori"          styleClass="nav-button" onAction="#handleKategori"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator styleClass="sidebar-divider"/>
        <Button text="🚪  Logout"            styleClass="nav-button-danger" onAction="#handleLogout"/>
    </VBox>

    <!-- ====== KONTEN ====== -->
    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true" styleClass="scroll-pane">
        <VBox styleClass="content-area" spacing="20">

            <!-- Header -->
            <VBox spacing="4">
                <Label text="Manajemen Anggaran" styleClass="label-judul-halaman"/>
                <Label text="Tetapkan batas pengeluaran per kategori untuk mengontrol keuangan Anda."
                       styleClass="label-subtitle"/>
            </VBox>

            <HBox spacing="16" alignment="TOP_LEFT">

                <!-- ── Form Tambah / Edit ── -->
                <VBox styleClass="card" spacing="16" minWidth="260" maxWidth="280">
                    <Label fx:id="lblFormJudul" text="Tambah Anggaran"
                           styleClass="label-section"/>

                    <VBox spacing="6">
                        <Label text="Kategori Pengeluaran" styleClass="label-form"/>
                        <ComboBox fx:id="cbKategori" prefWidth="240"
                                  promptText="Pilih kategori"
                                  styleClass="combo-box"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Limit Nominal (Rp)" styleClass="label-form"/>
                        <TextField fx:id="tfLimit"
                                   promptText="Contoh: 500000"
                                   styleClass="text-field"
                                   prefWidth="240"/>
                    </VBox>

                    <Label fx:id="lblFormError" text="" styleClass="label-expense"
                           wrapText="true" maxWidth="240"/>

                    <HBox spacing="8">
                        <Button fx:id="btnSimpan" text="💾 Simpan"
                                styleClass="btn-primary"
                                onAction="#handleSimpan"
                                prefWidth="110"/>
                        <Button text="✖ Batal"
                                styleClass="btn-secondary"
                                onAction="#handleBatalEdit"
                                prefWidth="110"/>
                    </HBox>
                </VBox>

                <!-- ── Tabel Anggaran ── -->
                <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                    <Label text="Daftar Anggaran Bulan Ini" styleClass="label-section"/>

                    <TableView fx:id="tableAnggaran" VBox.vgrow="ALWAYS"
                               styleClass="table-view"
                               prefHeight="400">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="kolKategori"  text="Kategori"     prefWidth="130"/>
                            <TableColumn fx:id="kolLimit"     text="Limit"        prefWidth="120"/>
                            <TableColumn fx:id="kolRealisasi" text="Terpakai"     prefWidth="120"/>
                            <TableColumn fx:id="kolSisa"      text="Sisa"         prefWidth="110"/>
                            <TableColumn fx:id="kolStatus"    text="Status"       prefWidth="90"/>
                            <TableColumn fx:id="kolAksi"      text="Aksi"         prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>

            </HBox>
        </VBox>
    </ScrollPane>
</HBox>
